# Gemini API Key (Required for server-side LLM call - get from aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended model: gemini-2.5-flash or gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Backend server port
PORT=5000

# Development-only AI Failure Simulation Flag (set to 'true' for evaluation testing)
AI_TEST_MODE=false
